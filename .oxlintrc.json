{
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "unicorn", "react"],
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-undef": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "no-debugger": "error",
    "eqeqeq": ["error", "smart"],
    "react/set-state-in-effect": "off",
    "react/refs": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    ".wrangler/**",
    ".rose/**",
    ".bug-hunter/**",
    ".ai-ship-worktrees/**",
    "**/*.d.ts"
  ],
  "overrides": [{ "files": [".claude/hooks/**/*.mjs"], "env": { "node": true } }]
}
