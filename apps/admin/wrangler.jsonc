{
  // Operator console worker. Note what is absent: no tenant database binding, no tenant keys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rose-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/__dev/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "rose-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/core/migrations" }
  ],
  "ratelimits": [{ "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Rose",
    "APP_BASE_DOMAIN": "example.com",
    "APP_URL_TEMPLATE": "https://{host}",
    "EMAIL_PROVIDER": "console",
    "BOOTSTRAP_OPERATOR_EMAIL": ""
  }
  // Secrets (set by `pnpm setup`): ROSE_MASTER_KEY (different from the app worker's), RESEND_API_KEY
}
