{
  // Tenant app worker. Placeholders only: `pnpm setup --production` writes your real ids and domain to the git-ignored wrangler.production.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rose-app",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "example.com/*", "zone_name": "example.com" }, { "pattern": "*.example.com/*", "zone_name": "example.com" }],
  // Serve only through the routes below: no workers.dev URL and no preview URLs to bypass them.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*", "/svc/*", "/__dev/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "rose-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/core/migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "TENANT_DO", "class_name": "TenantDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO"] }],
  "ratelimits": [{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Jobs start when queued. The hourly cron only sweeps expired records and re-runs any job whose message was lost.
  "queues": {
    "producers": [{ "binding": "APP_JOBS", "queue": "rose-app-jobs" }],
    "consumers": [{ "queue": "rose-app-jobs", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Rose",
    "APP_BASE_DOMAIN": "example.com",
    "EMAIL_PROVIDER": "resend",
    "UPSTREAM_MODE": "off",
    "EMAIL_FROM": "Rose <no-reply@update.example.com>"
  }
  // Secrets (set by `pnpm setup`): ROSE_MASTER_KEY, UPSTREAM_SIGNING_SECRET, RESEND_API_KEY
}
