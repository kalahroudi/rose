{
  // Tenant app worker. `pnpm setup` fills in the ids and domain; do not edit them by hand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rose-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*", "/svc/*", "/__dev/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "rose-control", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/core/migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "TENANT_DO", "class_name": "TenantDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO"] }],
  "ratelimits": [{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Rose",
    "APP_BASE_DOMAIN": "example.com",
    "EMAIL_PROVIDER": "console",
    "UPSTREAM_MODE": "off"
  }
  // Secrets (set by `pnpm setup`): ROSE_MASTER_KEY, UPSTREAM_SIGNING_SECRET, RESEND_API_KEY
}
