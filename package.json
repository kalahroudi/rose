{
  "name": "rose",
  "private": true,
  "version": "0.1.0",
  "description": "Security-first multi-tenant SaaS starter kit for Cloudflare, built for AI-agent development",
  "license": "Apache-2.0",
  "author": "kalahroudi",
  "repository": { "type": "git", "url": "https://github.com/kalahroudi/rose.git" },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter './apps/*' build",
    "lint": "oxlint --type-aware",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "guard": "node scripts/guard.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"examples/**/*.test.mjs\"",
    "test:scripts:coverage": "node -e \"require('fs').mkdirSync('scripts/coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-include=\"examples/**/*.mjs\" --test-coverage-exclude=\"**/*.test.mjs\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=scripts/coverage/lcov.info \"scripts/*.test.mjs\" \"examples/**/*.test.mjs\"",
    "verify": "pnpm guard && pnpm lint && pnpm knip && pnpm test:scripts && pnpm typecheck && pnpm test",
    "ci:local": "node scripts/ci-local.mjs",
    "brand": "node scripts/brand.mjs",
    "pentest": "node scripts/pentest.mjs",
    "formal": "node scripts/formal.mjs",
    "deploy": "node scripts/deploy.mjs",
    "knip": "knip",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "knip": "6.45.1",
    "oxc-parser": "0.156.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2"
  }
}
